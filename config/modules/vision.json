{
    "modelPath": "./models/vision/yolov5.onnx",
    "threshold": 0.85,
    "inputSize": [640, 640],
    "maxBatchSize": 4,
    "deviceType": "cuda",
    "preprocessing": {
        "normalize": true,
        "meanValues": [0.485, 0.456, 0.406],
        "stdValues": [0.229, 0.224, 0.225],
        "resizeMode": "letterbox"
    },
    "cache": {
        "enabled": true,
        "maxSize": 1000,
        "ttl": 3600
    },
    "outputProcessing": {
        "nmsThreshold": 0.45,
        "maxDetections": 100,
        "confidenceThreshold": 0.25
    },
    "features": {
        "objectDetection": true,
        "faceRecognition": true,
        "poseEstimation": true,
        "segmentation": false
    },
    "streaming": {
        "enabled": true,
        "maxFPS": 30,
        "resolution": {
            "width": 1280,
            "height": 720
        }
    },
    "optimization": {
        "tensorRT": false,
        "quantization": "fp16",
        "dynamicBatching": true
    }
} 