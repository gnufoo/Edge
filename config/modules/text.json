{
    "model": "gpt-4-turbo",
    "maxTokens": 2000,
    "temperature": 0.7,
    "systemPrompt": "You are a helpful multi-modal AI assistant.",
    "contextWindow": {
        "maxMessages": 10,
        "maxTokens": 8000
    },
    "rateLimiting": {
        "maxRequestsPerMinute": 60,
        "maxTokensPerMinute": 90000
    },
    "fallbackModel": {
        "model": "gpt-3.5-turbo",
        "maxTokens": 1000,
        "temperature": 0.8
    },
    "outputFormatting": {
        "trimWhitespace": true,
        "removeExtraNewlines": true,
        "maxParagraphLength": 500
    }
} 